erDiagram
  users ||--o{ grades : "student_id"
  classes ||--o{ grades : "class_id"
  evaluations |o--o{ grades : "evaluation_id"
  grades ||--o| recovery_goals : "grade_id (ON DELETE CASCADE)"
  grades {
    uuid id PK
    uuid class_id FK
    uuid student_id FK
    uuid evaluation_id FK "nullable"
    text subject
    double value
    double max
    double coef
    date graded_on
    timestamptz created_at
  }
  recovery_goals {
    uuid grade_id PK, FK "une note, au plus une ligne"
    int target "CHECK (target > 0)"
    int days "CHECK (days BETWEEN 1 AND 365), vide = 14 j"
    timestamptz created_at "DEFAULT now()"
  }
  users {
    uuid id PK
    text display_name
  }
  classes {
    uuid id PK
    uuid trainer_id FK
  }
  evaluations {
    uuid id PK
    uuid class_id FK
  }
